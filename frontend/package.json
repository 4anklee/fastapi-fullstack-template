{
    "name": "frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -p tsconfig.build.json && vite build",
        "lint": "biome check --write --unsafe --no-errors-on-unmatched --files-ignore-unknown=true ./",
        "preview": "vite preview",
        "gen:client": "curl 'http://localhost:8000/api/v1/openapi.json' -o openapi.json && openapi-ts",
        "test": "playwright test",
        "test:ui": "playwright test --ui"
    },
    "dependencies": {
        "@gravity-ui/icons": "^2.23.0",
        "@heroui/react": "^3.2.6",
        "@heroui/styles": "^3.2.6",
