# Local development only. Match POSTGRES_* to your local PostgreSQL instance.
PROJECT_NAME="My App"
ENVIRONMENT=local
FRONTEND_HOST=http://localhost:5173
SECRET_KEY=local-development-secret-replace-before-deploying
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=local-admin-password

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-db-password

# Optional local email capture; required by password recovery browser tests.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=false
EMAILS_FROM_EMAIL=noreply@example.com
MAILCATCHER_HOST=http://localhost:1080
